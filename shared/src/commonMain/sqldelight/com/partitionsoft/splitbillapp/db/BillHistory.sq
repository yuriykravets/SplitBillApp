CREATE TABLE bill_history (
    id TEXT NOT NULL PRIMARY KEY,
    created_at_millis INTEGER NOT NULL,
    title TEXT NOT NULL,
    note TEXT NOT NULL,
    currency_code TEXT NOT NULL,
    bill_amount_minor INTEGER NOT NULL,
    tip_basis_points INTEGER NOT NULL,
    additional_charge_minor INTEGER NOT NULL,
    participants_json TEXT NOT NULL
);

CREATE INDEX idx_bill_history_created_at ON bill_history(created_at_millis DESC);

selectAll:
SELECT *
FROM bill_history
ORDER BY created_at_millis DESC;

insertOrReplace:
INSERT OR REPLACE INTO bill_history(
    id,
    created_at_millis,
    title,
    note,
    currency_code,
    bill_amount_minor,
    tip_basis_points,
    additional_charge_minor,
    participants_json
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM bill_history
WHERE id = ?;

deleteAll:
DELETE FROM bill_history;
